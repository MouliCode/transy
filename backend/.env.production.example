APP_IMAGE_TAG=0.0.1
WS_API_KEY=replace-with-very-strong-random-value
TRACING_SAMPLING_PROBABILITY=0.2
OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
LOG_PATH=/tmp/logs
LOG_LEVEL_ROOT=INFO
LOG_MAX_FILE_SIZE=20MB
LOG_ERROR_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=2GB
LOG_QUEUE_SIZE=4096
APP_LOG_ROOT_LEVEL=3

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=transy
POSTGRES_USER=transy
POSTGRES_PASSWORD=replace-with-strong-db-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBSUB_ENABLED=true
REDIS_RELAY_CHANNEL=signaling:relay

GATEWAY_PORT=8080
CONFIG_PORT=8888
DEVICE_PORT=8083
DISCOVERY_PORT=8761
SIGNALING_PORT=8082
TRANSFER_PORT=8085
